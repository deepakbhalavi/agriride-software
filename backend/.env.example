# AgriRide Backend Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=sqlite:///./agriride.db
# For MySQL:  mysql+pymysql://user:password@localhost/agriride
# For Postgres: postgresql://user:password@localhost/agriride

# JWT
SECRET_KEY=agriride-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=AgriRide
APP_VERSION=1.0.0
DEBUG=True

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
